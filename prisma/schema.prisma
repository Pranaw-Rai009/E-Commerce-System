// schema.prisma defines WHAT your database looks like (tables/models) and WHAT kind of client code to generate;

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// PascalCase Naming
enum UserRole {
  Customer
  Seller
}

model User {
  id              Int       @id @default(autoincrement())
  fullName        String
  userName        String    @unique
  mobileNo        String    @unique
  email           String    @unique
  password        String
  profilePic      String?
  role            UserRole  @default(Customer)
  shippingAddress String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  productSold     Product[]
  review          Review[]
  cart            Cart? //as one user has only one cart
  order           Order[]
}

model Product {
  id          Int          @id @default(autoincrement())
  title       String
  prodImages  String[]
  description String
  stock       Int
  price       Float
  sellerId    Int
  seller      User         @relation(fields: [sellerId], references: [id])
  categoryId  Int
  category    Category     @relation(fields: [categoryId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  review      Review[] //referencing the review schema back
  cartItem    CartItems[] //referencing the cartItem schema back
  orderItems  OrderItems[]
}

model Category {
  id        Int       @id @default(autoincrement())
  title     String
  createdAt DateTime  @default(now())
  products  Product[]
}

model Review {
  id          Int      @id @default(autoincrement())
  description String
  productId   Int
  prodReview  Product  @relation(fields: [productId], references: [id])
  userId      Int
  userRef     User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([userId, productId])
}

model Cart {
  id       Int         @id @default(autoincrement())
  userId   Int         @unique
  user     User        @relation(fields: [userId], references: [id])
  cartItem CartItems[]
}

model CartItems {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id])
}

enum DeliveryStat {
  PENDING
  DELIVERED
}

enum PaymentStat {
  PENDING
  PAID
}

enum PaymentMetohd {
  ONLINE
  CASH_ON_DELIVERY
}

model Order {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  deliveryCharge  Float
  subTotal        Float
  totalAmount     Float
  shippingAddress String
  status          DeliveryStat  @default(PENDING)
  createdAt       DateTime      @default(now())
  orderItems      OrderItems[]
  paymentMetohd   PaymentMetohd
  paymentStatus   PaymentStat   @default(PENDING)
}

model OrderItems {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
}
